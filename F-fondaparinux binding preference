        "\n",
        "    def embed(self, texts):\n",
        "        encoded = self.tokenizer(\n",
        "            texts,\n",
        "            padding=True,\n",
        "            truncation=True,\n",
        "            max_length=256,\n",
        "            return_tensors=\"pt\"\n",
        "        )\n",
        "        with torch.no_grad():\n",
        "            output = self.model(**encoded)\n",
        "        return output.last_hidden_state[:, 0, :].numpy()\n",
